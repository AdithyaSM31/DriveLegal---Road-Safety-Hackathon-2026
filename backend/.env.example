# DriveLegal Environment Configuration
# Copy this file to .env and fill in the values

# Groq API Key (fast inference for Llama 3)
GROQ_API_KEY=your_groq_api_key_here

# Database path (relative to backend/)
DATABASE_PATH=../data/drivelegal.db

# ChromaDB path
CHROMA_DB_PATH=../data/chroma_db

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
